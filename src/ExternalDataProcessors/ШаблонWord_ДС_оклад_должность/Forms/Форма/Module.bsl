


&НаКлиенте
Процедура Печать(ИдентификаторКоманды, ОбъектыНазначения) Экспорт
	
	Если ИдентификаторКоманды = "ШаблонWord_ДС_оклад_должность" Тогда
		
		ИмяМакета = "ПФ_DOC_Договор";
		
		ОписаниеОповещения = Новый ОписаниеОповещения(
			"ПроверитьПроведенностьЗавершение", 
			ЭтотОбъект, Новый Структура("ИмяМакета", ИмяМакета));
		
		УправлениеПечатьюКлиент.ПроверитьПроведенностьДокументов(ОписаниеОповещения, ОбъектыНазначения, ВладелецФормы);
		
	КонецЕсли;			
	                                
КонецПроцедуры 

&НаКлиенте
Процедура ПроверитьПроведенностьЗавершение(ОбъектыНазначения, ДополнительныеПараметры) Экспорт
	
	ИмяМакета = ДополнительныеПараметры.ИмяМакета;
	
	МассивИменМакетов = Новый Массив;
	МассивИменМакетов.Добавить(ИмяМакета);
	МакетыИДанныеОбъекта = ПолучитьДанныеПечати(ОбъектыНазначения, МассивИменМакетов);
	
	ТипМакета = МакетыИДанныеОбъекта.Макеты.ТипыМакетов[ИмяМакета];	
	Области = МакетыИДанныеОбъекта.Макеты.ОписаниеОбластей; 					
	ДвоичныеДанныеМакета = МакетыИДанныеОбъекта.Макеты.ДвоичныеДанныеМакетов[ИмяМакета];	
	
	Макет = УправлениеПечатьюКлиент.ИнициализироватьМакетОфисногоДокумента(ДвоичныеДанныеМакета, ТипМакета, ИмяМакета);
	
	Если Макет <> Неопределено Тогда
			
		Для Каждого ДокументСсылка Из ОбъектыНазначения Цикл	
		
			ДанныеОбъекта = МакетыИДанныеОбъекта.Данные[ДокументСсылка][ИмяМакета];					
			
			ЗакрытьОкноПечатнойФормы = Ложь;
			
			Попытка
				
				ПечатнаяФорма = УправлениеПечатьюКлиент.ИнициализироватьПечатнуюФорму(ТипМакета, Макет.НастройкиСтраницыМакета, Макет);
				
				Если ПечатнаяФорма = Неопределено Тогда
					УправлениеПечатьюКлиент.ОчиститьСсылки(Макет);
					Возврат;
				КонецЕсли;
						
				// Вывод заголовка документа.
				Область = УправлениеПечатьюКлиент.ОбластьМакета(Макет, Области[ИмяМакета]["Заголовок"]);
				УправлениеПечатьюКлиент.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма, Область, ДанныеОбъекта, Ложь);						
				УправлениеПечатьюКлиент.ПоказатьДокумент(ПечатнаяФорма);
				
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
				ЗакрытьОкноПечатнойФормы = Истина;			
			КонецПопытки;
			
			УправлениеПечатьюКлиент.ОчиститьСсылки(ПечатнаяФорма, ЗакрытьОкноПечатнойФормы);
				
		КонецЦикла;		
					
	КонецЕсли;   
	
	УправлениеПечатьюКлиент.ОчиститьСсылки(Макет);	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДанныеПечати(Знач МассивДокументов, Знач МассивИменМакетов) Экспорт
	
	ДанныеПоВсемОбъектам = Новый Соответствие;
	
	Для Каждого ОбъектСсылка Из МассивДокументов Цикл
		ДанныеОбъектаПоМакетам = Новый Соответствие;
		Для Каждого ИмяМакета Из МассивИменМакетов Цикл
			ДанныеОбъектаПоМакетам.Вставить(ИмяМакета, ПолучитьДанныеОбъекта(ОбъектСсылка));
		КонецЦикла;
		ДанныеПоВсемОбъектам.Вставить(ОбъектСсылка, ДанныеОбъектаПоМакетам);
	КонецЦикла;
	
	ОписаниеОбластей = Новый Соответствие;
	ДвоичныеДанныеМакетов = Новый Соответствие;
	ТипыМакетов = Новый Соответствие;
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Для Каждого ИмяМакета Из МассивИменМакетов Цикл
		ДвоичныеДанныеМакета = ОбработкаОбъект.ПолучитьМакет(ИмяМакета);
		ДвоичныеДанныеМакетов.Вставить(ИмяМакета, ДвоичныеДанныеМакета);
		Позиция = Найти(ИмяМакета, "_");
		Подстрока = Сред(ИмяМакета, Позиция + 1, СтрДлина(ИмяМакета) - Позиция); 
		Позиция = Найти(Подстрока, "_");
		ТипМакета = Лев(Подстрока, Позиция - 1); 
		ТипыМакетов.Вставить(ИмяМакета, ТипМакета);
		ОписаниеОбластей.Вставить(ИмяМакета, ПолучитьОписаниеОбластейМакетаОфисногоДокумента());
	КонецЦикла;
	
	Макеты = Новый Структура;
	Макеты.Вставить("ОписаниеОбластей", ОписаниеОбластей);
	Макеты.Вставить("ТипыМакетов", ТипыМакетов);
	Макеты.Вставить("ДвоичныеДанныеМакетов", ДвоичныеДанныеМакетов);
	
	Результат = Новый Структура;	
	Результат.Вставить("Данные", ДанныеПоВсемОбъектам);
	Результат.Вставить("Макеты", Макеты);
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеОбъекта(СсылкаНаДокумент)
		
	СтруктураДат = Неопределено;
	ТекСсылкаНаДокумент = СсылкаНаДокумент;
	Если ТипЗнч(СсылкаНаДокумент) <> Тип("СправочникСсылка.Сотрудники") тогда
		ТекСсылкаНаДокумент = СсылкаНаДокумент.Сотрудник;
		СтруктураДат = СсылкаНаДокумент.ДатаНачала;
	КонецЕсли;
	ТекМассивСыслокНаДокумент = Новый Массив;
	ТекМассивСыслокНаДокумент.Добавить(ТекСсылкаНаДокумент);
	
	ДанныеДоговоров_ = ДанныеТрудовыхДоговоров_(ТекМассивСыслокНаДокумент, Ложь, Ложь, СтруктураДат);
	
	//Сообщить(ДанныеДоговоров_.Количество());
	
	//scoms удалим повторяющиеся элементы массива
	ДанныеДоговоров = УдалитьПовторяющиесяЭлементыМассива(ДанныеДоговоров_);
	
	ДанныеОбъекта = Новый Структура();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	&Сотрудник КАК Сотрудник,
	|	&ФизическоеЛицо КАК ФизическоеЛицо
	|ПОМЕСТИТЬ ВТ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ.Сотрудник КАК Сотрудник,
	|	ВТ.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ЕСТЬNULL(ОсновныеДанныеКонтрактаДоговораСотрудникаСрезПоследних.ДатаДоговораКонтракта, ДАТАВРЕМЯ(1, 1, 1)) КАК ТрудовойДоговорДата,
	|	ЕСТЬNULL(ОсновныеДанныеКонтрактаДоговораСотрудникаСрезПоследних.НомерДоговораКонтракта, """") КАК ТрудовойДоговорНомер,
	|	ЕСТЬNULL(ФизическиеЛицаКонтактнаяИнформация.Представление, """") КАК Адрес
	|ИЗ
	|	ВТ КАК ВТ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ОсновныеДанныеКонтрактаДоговораСотрудника.СрезПоследних(, Сотрудник = &Сотрудник) КАК ОсновныеДанныеКонтрактаДоговораСотрудникаСрезПоследних
	|		ПО ВТ.Сотрудник = ОсновныеДанныеКонтрактаДоговораСотрудникаСрезПоследних.Сотрудник
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица.КонтактнаяИнформация КАК ФизическиеЛицаКонтактнаяИнформация
	|		ПО ВТ.ФизическоеЛицо = ФизическиеЛицаКонтактнаяИнформация.Ссылка
	|			И (ФизическиеЛицаКонтактнаяИнформация.Вид = &ВидКИ)
	|			И (ФизическиеЛицаКонтактнаяИнформация.Тип = &ТипКИ)"; 
	
	
	Запрос.УстановитьПараметр("Сотрудник", ТекСсылкаНаДокумент);
	Запрос.УстановитьПараметр("ФизическоеЛицо", ТекСсылкаНаДокумент.ФизическоеЛицо);
	Запрос.УстановитьПараметр("ВидКИ", Справочники.ВидыКонтактнойИнформации.АдресПоПропискеФизическиеЛица);
	Запрос.УстановитьПараметр("ТипКИ", Перечисления.ТипыКонтактнойИнформации.Адрес);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		
		ДанныеОбъекта.Вставить("ДатаДоговора", Формат(ВыборкаДетальныеЗаписи.ТрудовойДоговорДата, "ДФ='''""''dd''""'' MMMM yyyy ""г.""'"));	    
		ДанныеОбъекта.Вставить("НомерДоговора", СокрЛП(ВыборкаДетальныеЗаписи.ТрудовойДоговорНомер));
		ДанныеОбъекта.Вставить("АдресРегистрации",   ВыборкаДетальныеЗаписи.Адрес);
		ДанныеОбъекта.Вставить("ДатаРождения",  Формат(ВыборкаДетальныеЗаписи.ФизическоеЛицо.ДатаРождения, "ДФ=dd.MM.yyyy"));
		//ДанныеОбъекта.Вставить("ВремяС",   "9.00");
		//ДанныеОбъекта.Вставить("ВремяПо",   "18.00");

		//Попытка   
		//	
		//	Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Сотрудник.С) Тогда
		//		ДанныеОбъекта.Вставить("ВремяС",   СокрЛП(ВыборкаДетальныеЗаписи.Сотрудник.С)); 
		//	КонецЕсли;
		//
		//	Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.Сотрудник.По) Тогда
		//		ДанныеОбъекта.Вставить("ВремяПо",   СокрЛП(ВыборкаДетальныеЗаписи.Сотрудник.ПО)); 
		//	КонецЕсли;
		//	
		//Исключение
		//КонецПопытки;

		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВидыДокументовФизическихЛиц.Ссылка КАК Ссылка,
		|	ВидыДокументовФизическихЛиц.Наименование КАК Наименование
		|ПОМЕСТИТЬ ВидыДокументов
		|ИЗ
		|	Справочник.ВидыДокументовФизическихЛиц КАК ВидыДокументовФизическихЛиц
		|ГДЕ
		|	ВидыДокументовФизическихЛиц.Наименование ПОДОБНО ""Паспорт гражданина%""
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ФИОФизическихЛицСрезПоследних.Фамилия КАК Фамилия,
		|	ФИОФизическихЛицСрезПоследних.Имя КАК Имя,
		|	ФИОФизическихЛицСрезПоследних.Отчество КАК Отчество
		|ИЗ
		|	РегистрСведений.ФИОФизическихЛиц.СрезПоследних(&Период, ФизическоеЛицо = &Физлицо) КАК ФИОФизическихЛицСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ДокументыФизическихЛицСрезПоследних.Серия КАК Серия,
		|	ДокументыФизическихЛицСрезПоследних.Номер КАК Номер,
		|	ДокументыФизическихЛицСрезПоследних.КодПодразделения КАК КодПодразделения,
		|	ДокументыФизическихЛицСрезПоследних.КемВыдан КАК ОрганВыдан,
		|	ДокументыФизическихЛицСрезПоследних.ДатаВыдачи КАК ДатаВыдачи,
		|	ВидыДокументов.Наименование КАК ВидДокумента
		|ИЗ
		|	РегистрСведений.ДокументыФизическихЛиц.СрезПоследних(
		|			&Период,
		|			Физлицо = &Физлицо
		|				И ВидДокумента В
		|					(ВЫБРАТЬ
		|						ВидыДокументов.Ссылка КАК Ссылка
		|					ИЗ
		|						ВидыДокументов КАК ВидыДокументов)) КАК ДокументыФизическихЛицСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ ВидыДокументов КАК ВидыДокументов
		|		ПО ДокументыФизическихЛицСрезПоследних.ВидДокумента = ВидыДокументов.Ссылка";
		
		Запрос.УстановитьПараметр("Период", ТекущаяДата());
		Запрос.УстановитьПараметр("Физлицо", ВыборкаДетальныеЗаписи.ФизическоеЛицо);		
		
		МассивПакетов = Запрос.ВыполнитьПакет();
		
		Если МассивПакетов[1].Пустой() Тогда
			ДанныеФИО = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ВыборкаДетальныеЗаписи.ФизическоеЛицо, "Фамилия, Имя, Отчество");		
		Иначе
			ДанныеФИО = МассивПакетов[1].Выбрать();
			ДанныеФИО.Следующий();
		КонецЕсли;				
		
		Если МассивПакетов[2].Пустой() Тогда
			СерияДокумента = "";
			НомерДокумента = "";
			КодПодразделения = "";
			ОрганВыдачи = "";
			ДатаВыдачи = "";
			ВидДокумента = НСтр("ru = 'Паспорт'");
		Иначе
			ДанныеДокумента = МассивПакетов[2].Выбрать();        
			ДанныеДокумента.Следующий();
			СерияДокумента = ДанныеДокумента.Серия;
			НомерДокумента = ДанныеДокумента.Номер;
			Если ЗначениеЗаполнено(НомерДокумента) Тогда
				НомерДокумента = НСтр("ru = '№'") + НомерДокумента;
			КонецЕсли;
			КодПодразделения = ДанныеДокумента.КодПодразделения;
			Если ЗначениеЗаполнено(КодПодразделения) Тогда
				КодПодразделения = НСтр("ru = ', Код подр.'") + КодПодразделения;
			КонецЕсли;
			ОрганВыдачи = ДанныеДокумента.ОрганВыдан;
			ДатаВыдачи = Формат(ДанныеДокумента.ДатаВыдачи, "ДФ='dd.MM.yyyy ""г.""'");
			ВидДокумента = ДанныеДокумента.ВидДокумента;
		КонецЕсли;
		
		ДанныеОбъекта.Вставить("Серия", СерияДокумента);
		ДанныеОбъекта.Вставить("Номер", НомерДокумента);
		ДанныеОбъекта.Вставить("КодПодразделения", КодПодразделения);										
		ДанныеОбъекта.Вставить("ОрганВыдачи", ОрганВыдачи);										
		ДанныеОбъекта.Вставить("ДатаВыдачи", ДатаВыдачи);										
		ДанныеОбъекта.Вставить("ФИО", ФИОИзЧастей(ДанныеФИО));
		ДанныеОбъекта.Вставить("ВидДокумента", ВидДокумента);
		
		
		// ищем размер оклада
		ТекРазмерОклада = 0;
		
		ЗапросОклад = Новый Запрос;
		ЗапросОклад.Текст =
		"ВЫБРАТЬ
		|	ЗначенияПериодическихПоказателейРасчетаЗарплатыСотрудниковСрезПоследних.Регистратор КАК Регистратор,
		|	ЗначенияПериодическихПоказателейРасчетаЗарплатыСотрудниковСрезПоследних.Сотрудник КАК Сотрудник,
		|	ЗначенияПериодическихПоказателейРасчетаЗарплатыСотрудниковСрезПоследних.Организация КАК Организация,
		|	ЗначенияПериодическихПоказателейРасчетаЗарплатыСотрудниковСрезПоследних.Показатель КАК Показатель,
		|	ЗначенияПериодическихПоказателейРасчетаЗарплатыСотрудниковСрезПоследних.Значение КАК Значение
		|ИЗ
		|	РегистрСведений.ЗначенияПериодическихПоказателейРасчетаЗарплатыСотрудников.СрезПоследних(
		|			&Период,
		|			Сотрудник = &ТекСотрудник
		|				И Показатель = &Оклад) КАК ЗначенияПериодическихПоказателейРасчетаЗарплатыСотрудниковСрезПоследних";
		
		ЗапросОклад.УстановитьПараметр("ТекСотрудник", ВыборкаДетальныеЗаписи.Сотрудник);
		ЗапросОклад.УстановитьПараметр("Период", КонецДня(СтруктураДат));
		ЗапросОклад.УстановитьПараметр("Оклад", Справочники.ПоказателиРасчетаЗарплаты.Оклад);
		
		РезультатОклад = ЗапросОклад.Выполнить().Выбрать();
		Пока РезультатОклад.Следующий() цикл
			ТекРазмерОклада = РезультатОклад.Значение;	
		КонецЦикла;
		
		// ищем должность 
		
		ТекДолжность = "";
		
		ЗапросДолжность = Новый Запрос;
		ЗапросДолжность.Текст =
		"ВЫБРАТЬ
		|	КадроваяИсторияСотрудниковСрезПоследних.Сотрудник КАК Сотрудник,
		|	КадроваяИсторияСотрудниковСрезПоследних.Регистратор КАК Регистратор,
		|	КадроваяИсторияСотрудниковСрезПоследних.ФизическоеЛицо КАК ФизическоеЛицо,
		|	КадроваяИсторияСотрудниковСрезПоследних.Должность КАК Должность,
		|	КадроваяИсторияСотрудниковСрезПоследних.Подразделение КАК Подразделение
		|ИЗ
		|	РегистрСведений.КадроваяИсторияСотрудников.СрезПоследних(&Период, Сотрудник = &ТекСотрудник) КАК КадроваяИсторияСотрудниковСрезПоследних";
		
		ЗапросДолжность.УстановитьПараметр("ТекСотрудник", ВыборкаДетальныеЗаписи.Сотрудник);
		ЗапросДолжность.УстановитьПараметр("Период", КонецДня(СтруктураДат));
		
		РезультатДолжность = ЗапросДолжность.Выполнить().Выбрать();
